# Copy to .env and fill in. Never commit .env.

# ── Qwen / Alibaba Cloud Model Studio ────────────────────────────────────────
DASHSCOPE_API_KEY=
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_ENDPOINT=
USE_MODEL_STUDIO=true
QWEN_MODEL=qwen-plus
QWEN_TURBO_MODEL=qwen-turbo
# Optional override; dated snapshots get retired
TTS_MODEL=qwen3-tts-flash
VL_MODEL=qwen3-vl-plus

# ── Alibaba Cloud OSS (audio cache, essay image hand-off, DB backups) ────────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ielts-memorycoach-audio
OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com

# ── App ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
POSTGRES_PASSWORD=
FRONTEND_URL=http://localhost:5173
# Bearer token for the admin-only /mcp-server endpoint; unset = endpoint disabled
MCP_API_TOKEN=

# ── Google sign-in + Calendar ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/schedule/calendar/callback

# ── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Random string passed as secret_token to setWebhook; unset = webhook disabled
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @, for the one-tap link in the web app (optional)
TELEGRAM_BOT_USERNAME=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret — verifies X-Hub-Signature-256; unset = webhook disabled
WHATSAPP_APP_SECRET=
# Token you choose for Meta's one-time webhook verification
WHATSAPP_VERIFY_TOKEN=
# Public number shown to learners, for the wa.me link in the web app (optional)
WHATSAPP_DISPLAY_NUMBER=
